{
  "name": "Manim Studio",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "remoteUser": "manimuser",
  "workspaceFolder": "/workspaces/Manim-Studio",
  "postCreateCommand": "/opt/venv/bin/python -m pip install --no-cache-dir -e '.[dev]' && /opt/venv/bin/python -m manim_studio.cli doctor",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Rickaym.manim-sideview",
        "analytic-signal.preview-mp4"
      ]
    }
  }
}
