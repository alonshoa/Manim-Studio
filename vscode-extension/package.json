{
  "name": "manim-studio-authoring",
  "displayName": "Manim Studio Authoring",
  "description": "Thin VS Code client for local Manim Studio interactive authoring sessions.",
  "version": "0.1.0",
  "publisher": "manim-studio",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:manimStudio.startAuthoringSession",
    "onCommand:manimStudio.resumeLastSession",
    "onCommand:manimStudio.switchActiveSession",
    "onCommand:manimStudio.pauseSession",
    "onCommand:manimStudio.finishSession",
    "onCommand:manimStudio.continueAuthoring",
    "onCommand:manimStudio.startLivePreview",
    "onCommand:manimStudio.previewActiveProposal",
    "onCommand:manimStudio.acceptActiveProposal",
    "onCommand:manimStudio.rejectActiveProposal",
    "onCommand:manimStudio.reviseActiveProposal",
    "onCommand:manimStudio.restartLivePreview",
    "onCommand:manimStudio.stopLivePreview",
    "onCommand:manimStudio.showSessionStatus",
    "onCommand:manimStudio.openWorkspace",
    "onCommand:manimStudio.openTerminal",
    "onCommand:manimStudio.refreshPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Manim Studio",
      "properties": {
        "manimStudio.studioExecutable": {
          "type": "string",
          "default": "studio",
          "description": "Studio executable or script used by the authoring extension."
        },
        "manimStudio.pythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable for future local environment selection."
        },
        "manimStudio.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for local Studio authoring RPC requests."
        },
        "manimStudio.renderRequestTimeoutMs": {
          "type": "number",
          "default": 180000,
          "description": "Timeout in milliseconds for embedded preview renders and other render-backed authoring requests."
        },
        "manimStudio.previewMode": {
          "type": "string",
          "enum": [
            "embedded",
            "externalOpenGL"
          ],
          "default": "embedded",
          "description": "Preview mode used by normal authoring commands. Embedded renders draft videos inside VS Code; externalOpenGL keeps the legacy OpenGL live window workflow."
        },
        "manimStudio.powerShellExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional explicit PowerShell executable for the dedicated Manim Studio integrated terminal. When empty, Windows prefers pwsh.exe and falls back to powershell.exe."
        },
        "manimStudio.openTerminalOnSessionStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the Manim Studio integrated terminal once when starting or resuming an authoring session."
        }
      }
    },
    "commands": [
      {
        "command": "manimStudio.openWorkspace",
        "title": "Manim Studio: Open Authoring Workspace"
      },
      {
        "command": "manimStudio.openTerminal",
        "title": "Manim Studio: Open Terminal"
      },
      {
        "command": "manimStudio.refreshPreview",
        "title": "Manim Studio: Refresh Preview Panel"
      },
      {
        "command": "manimStudio.startAuthoringSession",
        "title": "Manim Studio: Start Authoring Session"
      },
      {
        "command": "manimStudio.resumeLastSession",
        "title": "Manim Studio: Resume Last Session"
      },
      {
        "command": "manimStudio.switchActiveSession",
        "title": "Manim Studio: Switch Active Session"
      },
      {
        "command": "manimStudio.pauseSession",
        "title": "Manim Studio: Pause Session"
      },
      {
        "command": "manimStudio.finishSession",
        "title": "Manim Studio: Finish Session"
      },
      {
        "command": "manimStudio.continueAuthoring",
        "title": "Manim Studio: Continue Authoring"
      },
      {
        "command": "manimStudio.startLivePreview",
        "title": "Manim Studio: Start Live Preview"
      },
      {
        "command": "manimStudio.previewActiveProposal",
        "title": "Manim Studio: Preview Active Proposal"
      },
      {
        "command": "manimStudio.acceptActiveProposal",
        "title": "Manim Studio: Accept Active Proposal"
      },
      {
        "command": "manimStudio.rejectActiveProposal",
        "title": "Manim Studio: Reject Active Proposal"
      },
      {
        "command": "manimStudio.reviseActiveProposal",
        "title": "Manim Studio: Revise Active Proposal"
      },
      {
        "command": "manimStudio.restartLivePreview",
        "title": "Manim Studio: Restart Live Preview"
      },
      {
        "command": "manimStudio.stopLivePreview",
        "title": "Manim Studio: Stop Live Preview"
      },
      {
        "command": "manimStudio.showSessionStatus",
        "title": "Manim Studio: Show Session Status"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node test/manifest.test.js && node test/rpc-client.test.js && node test/rpc-client-behavior.test.js && node test/preview-panel.test.js && node test/session-commands.test.js && node test/terminal-manager.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
